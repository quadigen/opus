ALTER TABLE kinemium_packages ADD COLUMN readme TEXT NOT NULL DEFAULT '';
ALTER TABLE kinemium_packages ADD COLUMN archived_at BIGINT;
ALTER TABLE kinemium_packages ADD COLUMN archived_by TEXT;
ALTER TABLE kinemium_packages ADD COLUMN archive_reason TEXT NOT NULL DEFAULT '';

ALTER TABLE kinemium_package_versions ADD COLUMN changelog TEXT NOT NULL DEFAULT '';

ALTER TABLE kinemium_marketplace_acquisitions ADD COLUMN pinned_version TEXT;
ALTER TABLE kinemium_marketplace_acquisitions ADD COLUMN updated_at BIGINT NOT NULL DEFAULT 0;

UPDATE kinemium_marketplace_acquisitions SET updated_at = created_at;

ALTER TABLE kinemium_package_comments ADD COLUMN deleted_at BIGINT;
ALTER TABLE kinemium_package_comments ADD COLUMN deleted_by TEXT;

ALTER TABLE kinemium_marketplace_reviews ADD COLUMN deleted_at BIGINT;
ALTER TABLE kinemium_marketplace_reviews ADD COLUMN deleted_by TEXT;

CREATE TABLE IF NOT EXISTS kinemium_package_screenshots (
    screenshot_id TEXT PRIMARY KEY,
    package_id TEXT NOT NULL REFERENCES kinemium_packages(package_id) ON DELETE CASCADE,
    url TEXT NOT NULL,
    caption TEXT NOT NULL DEFAULT '',
    sort_order INTEGER NOT NULL DEFAULT 0,
    created_at BIGINT NOT NULL
);

CREATE INDEX IF NOT EXISTS kinemium_package_screenshots_package
    ON kinemium_package_screenshots (package_id, sort_order, screenshot_id);

CREATE TABLE IF NOT EXISTS kinemium_package_events (
    event_id TEXT PRIMARY KEY,
    package_id TEXT NOT NULL REFERENCES kinemium_packages(package_id) ON DELETE CASCADE,
    version TEXT,
    user_id TEXT,
    event_type TEXT NOT NULL CHECK (event_type IN ('download', 'install', 'uninstall', 'update')),
    created_at BIGINT NOT NULL
);

CREATE INDEX IF NOT EXISTS kinemium_package_events_package
    ON kinemium_package_events (package_id, created_at, event_id);
CREATE INDEX IF NOT EXISTS kinemium_package_events_type
    ON kinemium_package_events (package_id, event_type, created_at);

CREATE TABLE IF NOT EXISTS kinemium_reports (
    report_id TEXT PRIMARY KEY,
    target_type TEXT NOT NULL CHECK (target_type IN ('package', 'comment', 'review', 'user')),
    target_id TEXT NOT NULL,
    package_id TEXT REFERENCES kinemium_packages(package_id) ON DELETE CASCADE,
    reporter_user_id TEXT NOT NULL,
    reason TEXT NOT NULL,
    details TEXT NOT NULL DEFAULT '',
    status TEXT NOT NULL DEFAULT 'open' CHECK (status IN ('open', 'resolved', 'dismissed')),
    created_at BIGINT NOT NULL,
    resolved_by TEXT,
    resolved_at BIGINT,
    resolution_note TEXT NOT NULL DEFAULT ''
);

CREATE INDEX IF NOT EXISTS kinemium_reports_status
    ON kinemium_reports (status, created_at DESC, report_id DESC);

CREATE TABLE IF NOT EXISTS kinemium_admin_audit (
    audit_id TEXT PRIMARY KEY,
    actor_user_id TEXT NOT NULL,
    action TEXT NOT NULL,
    target_type TEXT NOT NULL,
    target_id TEXT NOT NULL,
    details TEXT NOT NULL DEFAULT '{}',
    created_at BIGINT NOT NULL
);

CREATE INDEX IF NOT EXISTS kinemium_admin_audit_created
    ON kinemium_admin_audit (created_at DESC, audit_id DESC);

CREATE TABLE IF NOT EXISTS kinemium_notifications (
    notification_id TEXT PRIMARY KEY,
    user_id TEXT NOT NULL,
    type TEXT NOT NULL,
    actor_user_id TEXT,
    package_id TEXT REFERENCES kinemium_packages(package_id) ON DELETE CASCADE,
    payload TEXT NOT NULL DEFAULT '{}',
    created_at BIGINT NOT NULL,
    read_at BIGINT
);

CREATE INDEX IF NOT EXISTS kinemium_notifications_user
    ON kinemium_notifications (user_id, created_at DESC, notification_id DESC);
CREATE INDEX IF NOT EXISTS kinemium_notifications_unread
    ON kinemium_notifications (user_id, read_at);

CREATE TABLE IF NOT EXISTS kinemium_webhooks (
    webhook_id TEXT PRIMARY KEY,
    user_id TEXT NOT NULL,
    url TEXT NOT NULL,
    secret TEXT NOT NULL,
    events TEXT NOT NULL DEFAULT '[]',
    active BOOLEAN NOT NULL DEFAULT TRUE,
    created_at BIGINT NOT NULL,
    updated_at BIGINT NOT NULL,
    last_delivery_at BIGINT,
    last_error TEXT
);

CREATE INDEX IF NOT EXISTS kinemium_webhooks_user
    ON kinemium_webhooks (user_id, created_at DESC, webhook_id DESC);

CREATE TABLE IF NOT EXISTS kinemium_webhook_deliveries (
    delivery_id TEXT PRIMARY KEY,
    webhook_id TEXT NOT NULL REFERENCES kinemium_webhooks(webhook_id) ON DELETE CASCADE,
    event_type TEXT NOT NULL,
    payload TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'pending',
    attempts INTEGER NOT NULL DEFAULT 0,
    response_code INTEGER,
    created_at BIGINT NOT NULL,
    delivered_at BIGINT
);

CREATE INDEX IF NOT EXISTS kinemium_webhook_deliveries_webhook
    ON kinemium_webhook_deliveries (webhook_id, created_at DESC, delivery_id DESC);

CREATE TABLE IF NOT EXISTS kinemium_idempotency (
    user_id TEXT NOT NULL,
    idempotency_key TEXT NOT NULL,
    method TEXT NOT NULL,
    path TEXT NOT NULL,
    status_code INTEGER NOT NULL,
    response TEXT NOT NULL,
    created_at BIGINT NOT NULL,
    PRIMARY KEY (user_id, idempotency_key, method, path)
);

CREATE INDEX IF NOT EXISTS kinemium_idempotency_created
    ON kinemium_idempotency (created_at);
